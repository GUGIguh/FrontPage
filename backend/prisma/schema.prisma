// Introspected from backend/src/db/schema.sql with `prisma db pull`, then renamed:
// models are PascalCase singular, fields camelCase; @map/@@map keep the real
// snake_case names in Postgres. Changes go through `prisma migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt         @id @default(autoincrement())
  email         String         @unique @db.Citext
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  bookmarks     Bookmark[]
  categories    Category[]
  readEntries   ReadEntry[]
  subscriptions Subscription[]

  @@map("users")
}

model Feed {
  id            BigInt         @id @default(autoincrement())
  url           String         @unique
  iconUrl       String?        @map("icon_url")
  siteUrl       String?        @map("site_url")
  description   String?
  title         String
  lastFetchedAt DateTime?      @map("last_fetched_at") @db.Timestamptz(6)
  failureCount  Int            @default(0) @map("failure_count")
  lastError     String?        @map("last_error")
  etag          String?
  lastModified  String?        @map("last_modified")
  entries       Entry[]
  subscriptions Subscription[]

  @@map("feeds")
}

model Category {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  title         String         @db.Citext
  position      Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions Subscription[]

  // (id, userId) is the target of the composite FK from subscriptions:
  // a subscription can only point to a category of the same user.
  @@unique([id, userId])
  @@unique([userId, title])
  @@map("categories")
}

model Entry {
  id          BigInt      @id @default(autoincrement())
  feedId      BigInt      @map("feed_id")
  author      String?
  title       String
  content     String?
  description String?
  publishedAt DateTime    @map("published_at") @db.Timestamptz(6)
  fetchedAt   DateTime    @default(now()) @map("fetched_at") @db.Timestamptz(6)
  url         String
  guid        String
  feed        Feed        @relation(fields: [feedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookmarks   Bookmark[]
  readEntries ReadEntry[]

  @@unique([feedId, guid])
  @@index([feedId, publishedAt(sort: Desc)])
  @@map("entries")
}

model ReadEntry {
  userId  BigInt   @map("user_id")
  entryId BigInt   @map("entry_id")
  readAt  DateTime @default(now()) @map("read_at") @db.Timestamptz(6)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entry   Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, entryId])
  @@index([entryId])
  @@map("read_entries")
}

model Bookmark {
  userId  BigInt   @map("user_id")
  entryId BigInt   @map("entry_id")
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entry   Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, entryId])
  @@index([entryId])
  @@map("bookmarks")
}

model Subscription {
  userId      BigInt    @map("user_id")
  feedId      BigInt    @map("feed_id")
  categoryId  BigInt?   @map("category_id")
  customTitle String?   @map("custom_title")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feed        Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // In the DB this is `ON DELETE SET NULL (category_id)` (hand-written in 0_init):
  // plain SET NULL would also null user_id. Prisma can't express the column list,
  // so never let a migration regenerate this FK without re-adding it.
  category    Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: SetNull, onUpdate: NoAction)

  @@id([userId, feedId])
  @@index([feedId])
  @@map("subscriptions")
}
